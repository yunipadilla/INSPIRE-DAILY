# Postgres (Supabase project "Inspire Daily", id tpqebxmtxxjjmlezsvej)
# Get from Supabase dashboard: Project Settings -> Database -> Connection string (URI tab)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.tpqebxmtxxjjmlezsvej.supabase.co:5432/postgres

# Auth
# REQUIRED — the server refuses to start without this (no insecure default).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Email (stub until real credentials are supplied — required for password
# reset and parental-consent emails to actually deliver; until then,
# sendEmail() logs what it would have sent instead of sending it).
# Recommended provider: Resend (resend.com) — generous free tier, good
# deliverability, and works with this generic SMTP setup with zero code
# changes: create an API key in Resend, then set SMTP_HOST=smtp.resend.com,
# SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<your Resend API key>.
# Postmark or SendGrid's SMTP credentials work the same way if preferred.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Inspire Daily <no-reply@inspiringchildren.org>"

# Twilio WhatsApp (stub until real credentials are supplied)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_GROUP_TO=

# External sync webhook (stub until a real endpoint is supplied)
SYNC_ENDPOINT_URL=

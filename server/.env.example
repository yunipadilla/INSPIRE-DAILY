# Postgres (Supabase project "Inspire Daily", id tpqebxmtxxjjmlezsvej)
# Get from Supabase dashboard: Project Settings -> Database -> Connection string (URI tab)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.tpqebxmtxxjjmlezsvej.supabase.co:5432/postgres

# Auth
# REQUIRED — the server refuses to start without this (no insecure default).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Email — REQUIRED in production for password-reset (and approval/consent)
# emails to actually be delivered. With nothing configured, sendEmail() only
# logs that it "would have" sent, and nobody receives anything.
#
# Preferred: Resend's HTTPS API (resend.com). It works on Render's FREE plan,
# which blocks outbound SMTP ports 25/465/587. Steps: create a Resend account,
# add + verify your sending domain (DNS records), create an API key, then set:
#   RESEND_API_KEY=<the API key>        (SECRET)
#   EMAIL_FROM="Inspire Daily <no-reply@your-verified-domain>"
RESEND_API_KEY=
EMAIL_FROM="Inspire Daily <no-reply@inspiringchildren.org>"
# Fallback only if RESEND_API_KEY is empty: classic SMTP. Will NOT work from a
# Render free plan (ports 25/465/587 blocked) — fine for local dev or paid plans.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: public URL used in email links. Defaults to CLIENT_ORIGIN; in
# production a localhost/http value is ignored in favor of the real app URL.
APP_URL=

# Twilio WhatsApp (stub until real credentials are supplied)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_GROUP_TO=

# External sync webhook (stub until a real endpoint is supplied)
SYNC_ENDPOINT_URL=
